  "text_processing": {
    "emoji": "emoji.demojize with space delimiters, then lowercase",
    "url_pattern": "http\\S+|www\\.\\S+",
    "character_filter": "[^a-z0-9\\s:]",
    "whitespace_pattern": "\\s+",
    "phrase_matching": "word boundaries; flexible whitespace; each distinct phrase counts once",
    "clause_split_pattern": "[\\n\\r.!?;]+|,\\s*(?=(?:tapi|cuma|namun|walau|meski|meskipun|tp)\\b)",
    "clause_split_before_cleaning": true,
    "contrast_matching_case_sensitive": true
  },
  "aspect_selection": {
    "specific": "one pair per matched specific aspect; general has no keyword list",
    "general_opinion": "no specific match and at least one global/opinion cue or a nonempty review with at most four cleaned tokens",
    "fallback": "general candidate for other unmatched reviews",
    "scope": "join clauses matching the target aspect keywords; use full cleaned review if none match; general joins all clauses"
  },
  "decision_order": [
    "count union of global and aspect-specific positive, negative, and neutral phrases",
    "strong negatives are global strong-negative cues union ALL aspect-specific negative cues",
    "each negation-safe hit adds one positive hit and subtracts one negative and strong-negative hit, floored at zero",
    "any remaining strong-negative hit -> negative",
    "positive hits only -> positive",
    "negative hits only -> negative",
    "both positive and negative -> exclude as mixed_polarity",
    "neutral hits only -> exclude as neutral_only",
    "otherwise -> exclude as default_excluded"
  ]
}
